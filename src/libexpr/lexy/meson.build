# Keep grammar template instantiation in parser.cc. Native construction is split
# into ordinary translation units so their bodies compile without the grammar.
parser_extra_sources += files(
  'native/attributes.cc',
  'native/calls.cc',
  'native/collections.cc',
  'native/control-flow.cc',
  'native/indented-strings.cc',
  'native/lambdas.cc',
  'native/literals.cc',
  'native/operators.cc',
  'native/paths.cc',
  'native/positions.cc',
  'native/strings.cc',
  'parser.cc',
)
